<Window x:Class="DrawingVerifier.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:DrawingVerifier.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}"
        mc:Ignorable="d"
        Title="Settings - Gemini AI &amp; Vision Options"
        Height="310"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Gemini API Key -->
        <TextBlock Grid.Row="0"
                   Text="Gemini API Key:"
                   FontWeight="SemiBold"
                   Margin="0,0,0,6" />

        <TextBox Grid.Row="1"
                 Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                 Height="28"
                 VerticalContentAlignment="Center"
                 Padding="6,2"
                 Margin="0,0,0,14" />

        <!-- Gemini Model Selection -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Gemini Model:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,6" />
            <ComboBox ItemsSource="{Binding AvailableGeminiModels}"
                      SelectedItem="{Binding SelectedGeminiModel}"
                      Height="28"
                      VerticalContentAlignment="Center" />
        </StackPanel>

        <!-- High-DPI Quadrant Tiling Toggle -->
        <StackPanel Grid.Row="3" Margin="0,0,0,10">
            <CheckBox IsChecked="{Binding EnableHighDpiTiling}"
                      Content="Enable High-DPI Quadrant Tiling (300 DPI)"
                      FontWeight="SemiBold" />
            <TextBlock Text="Rasterizes sheets at 300 DPI into 4 overlapping quadrants + full view to prevent line tracing and spatial errors on large sheets (A1/A0)."
                       TextWrapping="Wrap"
                       Foreground="#666666"
                       FontSize="11"
                       Margin="20,4,0,0" />
        </StackPanel>

        <!-- Save Button -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="Save"
                    Command="{Binding SaveCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                    IsDefault="True"
                    Width="90"
                    Padding="12,5" />
        </StackPanel>
    </Grid>
</Window>
