<Window x:Class="DrawingVerifier.UI.Views.SkillManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:DrawingVerifier.UI.ViewModels"
        d:DataContext="{d:DesignInstance Type=viewmodels:SkillManagerViewModel}"
        mc:Ignorable="d"
        Title="Skill &amp; Rules Manager"
        Height="720"
        Width="960"
        MinHeight="550"
        MinWidth="750"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Main Content 2-Column Grid -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Skills List and Actions -->
            <Grid Grid.Column="0" Margin="0,0,16,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Verification Skills"
                           FontWeight="Bold"
                           FontSize="14"
                           Margin="0,0,0,8" />

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Skills}"
                          SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Margin="0,0,0,8" />

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="Add"
                            Command="{Binding AddNewSkillCommand}"
                            Padding="12,6" />

                    <Button Grid.Column="2"
                            Content="Delete"
                            Command="{Binding DeleteSkillCommand}"
                            IsEnabled="{Binding HasSelectedSkill}"
                            Padding="12,6" />
                </Grid>
            </Grid>

            <!-- Right Column: Edit Form (Visible only when SelectedSkill is not null) -->
            <Grid Grid.Column="1">
                <!-- Fallback empty state when no skill is selected -->
                <TextBlock Text="Select a skill from the list or click 'Add' to create a new one."
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Foreground="#777777"
                           FontSize="13">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedSkill}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Edit Form -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding HasSelectedSkill, Converter={StaticResource BoolToVisConverter}}">
                    <StackPanel>
                        <!-- Skill Name -->
                        <TextBlock Text="Skill Name:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedSkill.Name, UpdateSourceTrigger=PropertyChanged}"
                                 Height="28"
                                 VerticalContentAlignment="Center"
                                 Margin="0,0,0,12" />

                        <!-- System Prompt -->
                        <TextBlock Text="System Prompt:"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedSkill.SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="110"
                                 Margin="0,0,0,12" />

                        <!-- Output Schema JSON -->
                        <TextBlock Text="Output Schema (JSON):"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        <TextBox Text="{Binding SelectedSkill.OutputSchemaJson, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 FontFamily="Consolas, Courier New, monospace"
                                 VerticalScrollBarVisibility="Auto"
                                 Height="130"
                                 Margin="0,0,0,12" />

                        <!-- Validation Rules (NCalc) -->
                        <GroupBox Header="Validation Rules (NCalc)" Margin="0,0,0,12">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Add Rule"
                                            Command="{Binding AddRuleCommand}"
                                            Padding="10,4"
                                            Margin="0,0,8,0" />

                                    <Button Content="Remove Rule"
                                            Command="{Binding RemoveRuleCommand}"
                                            CommandParameter="{Binding ElementName=RulesGrid, Path=SelectedItem}"
                                            Padding="10,4" />
                                </StackPanel>

                                <DataGrid x:Name="RulesGrid"
                                          Grid.Row="1"
                                          ItemsSource="{Binding SelectedSkill.Rules}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          MinHeight="130"
                                          MaxHeight="200"
                                          GridLinesVisibility="Horizontal"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Rule Name"
                                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="160" />
                                        <DataGridTextColumn Header="Expression (NCalc formula)"
                                                            Binding="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="*" />
                                        <DataGridTextColumn Header="Error Message"
                                                            Binding="{Binding ErrorMessage, UpdateSourceTrigger=PropertyChanged}"
                                                            Width="200" />
                                        <DataGridTemplateColumn Width="75">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Delete"
                                                            Padding="4,2"
                                                            Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </GroupBox>

                        <!-- Save Changes Button -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <Button Content="Save Changes"
                                    Command="{Binding SaveSkillCommand}"
                                    Padding="16,6"
                                    FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="1" Padding="6" Background="#F3F3F3" Margin="0,12,0,0">
            <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
        </Border>
    </Grid>
</Window>
